{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "mbxcn",
  "homepage": "https://mbxcn.owlsdont.com",
  "items": [
    {
      "name": "map",
      "type": "registry:ui",
      "title": "Map",
      "description": "A Mapbox GL map container with light/dark theming and a useMap() context for composing children.",
      "dependencies": ["mapbox-gl"],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/registry/map.tsx",
          "type": "registry:ui",
          "target": "components/ui/map.tsx"
        }
      ]
    },
    {
      "name": "marker",
      "type": "registry:ui",
      "title": "Marker",
      "description": "A marker placed at given coordinates. Renders a default pin or custom content, and exposes itself for an attached Popup.",
      "dependencies": ["mapbox-gl"],
      "registryDependencies": ["map"],
      "files": [
        {
          "path": "src/registry/marker.tsx",
          "type": "registry:ui",
          "target": "components/ui/marker.tsx"
        }
      ]
    },
    {
      "name": "popup",
      "type": "registry:ui",
      "title": "Popup",
      "description": "A popup with custom React content. Auto-attaches to a parent Marker, or stands alone at given coordinates.",
      "dependencies": ["mapbox-gl"],
      "registryDependencies": ["map", "marker"],
      "files": [
        {
          "path": "src/registry/popup.tsx",
          "type": "registry:ui",
          "target": "components/ui/popup.tsx"
        }
      ],
      "css": {
        ".mbxcn-popup .mapboxgl-popup-content": {
          "@apply !bg-transparent !p-0 !shadow-none !rounded-none": {}
        },
        ".mbxcn-popup .mapboxgl-popup-tip": {
          "@apply !hidden": {}
        }
      }
    },
    {
      "name": "controls",
      "type": "registry:ui",
      "title": "Controls",
      "description": "Tailwind-styled zoom and geolocate buttons overlaid on the map.",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["map", "button"],
      "files": [
        {
          "path": "src/registry/controls.tsx",
          "type": "registry:ui",
          "target": "components/ui/controls.tsx"
        }
      ]
    },
    {
      "name": "store-locator",
      "type": "registry:block",
      "title": "Store Locator",
      "description": "A full-page store locator: a searchable location list, fly-to navigation, and popups on a Mapbox map.",
      "dependencies": ["mapbox-gl", "lucide-react"],
      "registryDependencies": ["map", "marker", "popup", "controls"],
      "files": [
        {
          "path": "src/registry/blocks/store-locator/page.tsx",
          "type": "registry:page",
          "target": "app/store-locator/page.tsx"
        },
        {
          "path": "src/registry/blocks/store-locator/data.ts",
          "type": "registry:component",
          "target": "app/store-locator/data.ts"
        }
      ],
      "meta": { "iframeHeight": "640px" }
    }
  ]
}
