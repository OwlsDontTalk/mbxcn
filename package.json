{
  "name": "mbxcn",
  "version": "0.0.0",
  "private": true,
  "description": "Customizable Mapbox GL components for React. Built on Mapbox GL JS. Styled with Tailwind. Works with shadcn/ui. Install via shadcn CLI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
